# Development: run one FastAPI app on 8000 and Next.js on 3000.
AUTOASSIST_ENV=development
AUTOASSIST_AGENT_TOKEN=
AUTOASSIST_RATE_LIMIT_PER_MINUTE=20
AUTOASSIST_PROVIDER_REASONING=true
STORAGE_MODE=local
# For production use AUTOASSIST_ENV=production, Supabase auth, a long token,
# false for reasoning, HTTPS-specific CORS, and authenticated Next.js proxy.
