# AutoAssist unified FastAPI backend — CPU DistilBERT + FAISS installed by default.
# Build from the repository root:
#   docker build --platform linux/amd64 -f backend/Dockerfile.unified-v12 -t autoassist-backend:render-test .
# No INSTALL_DISTILBERT or INSTALL_FAISS build arguments are required.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    MODEL_VARIANT=multilabel_distilbert_v3 \
    RAG_BACKEND=faiss

WORKDIR /app

# Unified API, LangChain create_agent, AG-UI, and baseline dependencies.
COPY backend/requirements*.txt /app/backend/
RUN python -m pip install --no-cache-dir -r backend/requirements-unified-v12.txt

# Core AutoAssist features: always ship CPU DistilBERT and FAISS retrieval libraries.
# CPU-only PyTorch avoids pulling CUDA GPU dependencies into a Render CPU image.
RUN python -m pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir \
      'transformers>=4.45,<5' \
      'faiss-cpu>=1.8,<2' \
      'sentence-transformers>=3,<6' \
    && python -c "import torch, transformers, faiss, sentence_transformers; print('ML dependencies installed (CPU torch, Transformers, FAISS, sentence-transformers)')"

COPY backend /app/backend
COPY agent /app/agent
COPY scripts /app/scripts
# COPY the ml directory, not ml/artifacts directly: the directory may be absent
# from Git or excluded by .dockerignore. The model weights must still be supplied.
COPY ml/ /app/ml/
# Download the exact tested AutoAssist model revision during the build.
# The repository must be public for unauthenticated builds; do NOT bake HF tokens into images.
RUN python -m pip install --no-cache-dir 'huggingface_hub>=0.32,<2' \
    && mkdir -p /app/ml/artifacts/multilabel_distilbert_v3 \
    && python -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='2ashborn12/autoassist-distilbert-v3', revision='fa3a10b4314b119aefe444f71608fef4a0620bec', local_dir='/app/ml/artifacts/multilabel_distilbert_v3', allow_patterns=['model.safetensors', 'config.json', 'metrics.json', 'tokenizer.json', 'tokenizer_config.json', 'special_tokens_map.json', 'vocab.txt'])" \
    && test -s /app/ml/artifacts/multilabel_distilbert_v3/model.safetensors \
    && test -s /app/ml/artifacts/multilabel_distilbert_v3/config.json \
    && test -s /app/ml/artifacts/multilabel_distilbert_v3/tokenizer.json \
    && test -s /app/ml/artifacts/multilabel_distilbert_v3/metrics.json \
    && echo 'AutoAssist DistilBERT v3 artifacts verified in Docker image'

RUN adduser --system --group --uid 10001 appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000
# The current LangGraph checkpointer is in-memory; retain one worker.
CMD ["sh", "-c", "exec uvicorn backend.app.main:app --host 0.0.0.0 --workers 1 --port ${PORT:-8000}"]
