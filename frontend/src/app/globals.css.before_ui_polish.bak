@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{--bg:#f7f8fa;--ink:#1b2838;--muted:#81909e;--navy:#102331;--border:#e5eaef;--green:#197c65;font-family:'DM Sans',sans-serif;color:var(--ink);background:var(--bg)}*{box-sizing:border-box}body{margin:0}button,input,textarea{font:inherit}button{cursor:pointer}button:disabled{opacity:.45;cursor:not-allowed}a{text-decoration:none;color:inherit}.aa-app{display:flex;min-height:100vh}.aa-nav{width:250px;background:#101f2d;color:#edf4f6;display:flex;flex-direction:column;padding:30px 18px;flex-shrink:0}.aa-brand{display:flex;align-items:center;gap:12px;font:800 20px Manrope;letter-spacing:-.65px}.aa-brand-mark{width:39px;height:39px;border-radius:12px;background:#d7be8d;color:#183044;display:grid;place-items:center}.aa-brand-sub{display:block;font:700 8px 'DM Sans';letter-spacing:1.7px;color:#8498a7;margin-top:3px}.aa-nav-items{display:flex;flex-direction:column;gap:9px;margin-top:56px}.aa-nav-items a{display:flex;align-items:center;gap:11px;padding:13px;border-radius:10px;font-size:13px;color:#a6b5c3}.aa-nav-items a:hover,.aa-nav-active{background:#213647!important;color:white!important}.aa-nav-footer{border-top:1px solid #2b3c49;margin-top:auto;padding:20px 8px 0;display:flex;align-items:center;gap:9px;font-size:11px;color:#bad2ce;flex-wrap:wrap}.aa-nav-footer span{font-size:10px;color:#728a9a;flex-basis:100%}.aa-main{min-width:0;flex:1}.aa-topbar{height:75px;background:#fff;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;padding:0 38px;font-size:11px}.aa-location{display:flex;align-items:center;gap:12px;color:#8c9ba8}.aa-location strong{color:#334d60}.aa-online-dot{width:7px;height:7px;background:#4ba48b;border-radius:50%}.aa-topbar-right{display:flex;gap:9px;align-items:center;color:#61788a}.aa-main-inner{display:grid;grid-template-columns:minmax(420px,1fr) 325px;max-width:1440px;min-height:calc(100vh - 75px);margin:auto}.aa-chat-area{display:flex;flex-direction:column;min-width:0;padding:0 36px 25px}.aa-welcome{padding:60px 0 28px;max-width:690px}.aa-welcome-icon{width:55px;height:55px;border:1px solid #e4d6b9;background:#f7f2e8;border-radius:18px;color:#a9844d;display:grid;place-items:center;margin-bottom:25px}.aa-kicker{color:#a6875d;font:800 10px 'DM Sans';letter-spacing:2px}.aa-welcome h1,.aa-lab-hero h1{font:800 clamp(28px,3.1vw,43px)/1.18 Manrope;letter-spacing:-1.8px;margin:14px 0 16px}.aa-welcome h1 em,.aa-lab-hero em{font-style:normal;color:#ba9162}.aa-welcome>p,.aa-lab-hero>p{font-size:13px;max-width:590px;color:#708392;line-height:1.9}.aa-suggestions{display:grid;gap:10px;margin-top:36px;max-width:680px}.aa-suggestions button{border:1px solid var(--border);border-radius:12px;padding:15px;background:#fff;display:flex;gap:16px;align-items:center;text-align:left;font-size:12px;color:#425566;transition:.15s}.aa-suggestions button:hover{border-color:#d0ae7b;background:#fffdf9}.aa-suggestions span{font:700 10px Manrope;color:#baa178}.aa-suggestions svg{margin-left:auto;transform:rotate(45deg);color:#8c9ba7;flex-shrink:0}.aa-messages{flex:1;display:flex;flex-direction:column;gap:23px;padding:26px 0;min-height:60px}.aa-message{display:flex;gap:13px;align-items:flex-start}.aa-message.user{flex-direction:row-reverse}.aa-message-avatar{width:34px;height:34px;flex-shrink:0;border-radius:11px;display:grid;place-items:center;background:#e6eeed;color:#347964;font:700 10px 'DM Sans'}.aa-message.user .aa-message-avatar{background:#102f42;color:#fff}.aa-message-content{max-width:85%;border-radius:13px;background:white;padding:14px 18px;border:1px solid var(--border);box-shadow:0 3px 10px #23344905}.aa-message.user .aa-message-content{background:#eaf0f2}.aa-message-name{font-size:10px;font-weight:800;color:#6e818e;margin-bottom:8px}.aa-markdown{font-size:12px;line-height:1.85;overflow-wrap:anywhere}.aa-markdown p{margin:6px 0}.aa-markdown ul,.aa-markdown ol{padding-left:22px}.aa-markdown a{text-decoration:underline;color:#2a6d8b}.aa-markdown table{display:block;overflow-x:auto;border-collapse:collapse}.aa-markdown th,.aa-markdown td{border:1px solid #e0e6e9;padding:5px 8px}.aa-processing{display:flex;align-items:center;gap:10px;color:#4b8b78;font-size:12px}.aa-composer{display:flex;align-items:flex-end;gap:9px;background:#fff;border:1px solid #dce4e8;border-radius:15px;padding:12px;box-shadow:0 8px 22px #25384f0c;position:sticky;bottom:15px}.aa-composer:focus-within{border-color:#b69b74}.aa-composer textarea{flex:1;min-width:0;border:0;resize:vertical;outline:none;max-height:145px;min-height:52px;padding:8px;line-height:1.6;font-size:13px;color:#223748}.aa-composer button{width:39px;height:39px;background:#18364b;color:#fff;border:none;border-radius:11px;display:grid;place-items:center}.aa-compose-caption{display:flex;align-items:center;justify-content:center;gap:7px;color:#9aaaae;font-size:10px;margin-top:20px;text-align:center}.aa-side-rail{border-left:1px solid var(--border);padding:29px 22px;background:#fcfdfd}.aa-workflow,.aa-context,.aa-method{border:1px solid var(--border);border-radius:14px;background:#fff;padding:20px;margin-bottom:16px}.aa-panel-heading{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.aa-panel-heading h3{font:800 16px Manrope;letter-spacing:-.5px;margin:9px 0}.aa-card-eyebrow{font-size:9px;letter-spacing:1.4px;font-weight:800;color:#8396a1;display:flex;gap:7px;align-items:center}.aa-running,.aa-idle{font-size:9px;font-weight:800;color:#63927e;display:flex;align-items:center;gap:6px}.aa-idle{color:#8ca0a8}.aa-running span,.aa-idle span{width:6px;height:6px;border-radius:50%;background:currentColor}.aa-step-list{margin-top:18px}.aa-step{display:flex;gap:12px;position:relative;padding-bottom:22px}.aa-step:not(:last-child):before{content:'';position:absolute;width:1px;left:9px;top:21px;bottom:3px;background:#e5e9eb}.aa-step-indicator{flex-shrink:0;color:#bec9cf}.aa-step.done .aa-step-indicator{color:#37a080}.aa-step.active .aa-step-indicator{color:#c2a36e}.aa-step strong{font-size:11px}.aa-step p{font-size:10px;line-height:1.6;margin:4px 0;color:#93a0ac}.aa-workflow-footnote,.aa-caption{font-size:10px;color:#95a4ad;line-height:1.6;margin-top:12px}.aa-info{font-size:10px;color:#a47b46;background:#fbf6ed;padding:10px;border-radius:8px;display:flex;align-items:flex-start;gap:7px}.aa-context strong,.aa-method strong{font:800 14px Manrope;display:block;margin-top:12px}.aa-context p,.aa-method p{color:#899ba7;font-size:11px;line-height:1.7}.aa-method a{display:flex;align-items:center;gap:8px;font-size:11px;font-weight:700;color:#377767;margin-top:17px}.aa-results{margin-left:48px;display:flex;flex-direction:column;gap:10px}.aa-result-card{background:#fff;border:1px solid var(--border);padding:17px;border-radius:12px}.aa-classification-row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:14px}.aa-classification-row strong{font:800 17px Manrope}.aa-classification-row span{color:#618e84;font-size:11px}.aa-score-track,.aa-lab-meter{height:7px;background:#edf1f2;border-radius:9px;overflow:hidden;margin-top:13px}.aa-score-track>div,.aa-lab-meter>div{height:100%;border-radius:9px;background:#56a98b}.aa-source-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:9px;margin-top:12px}.aa-evidence{border:1px solid #e5ebed;padding:13px;border-radius:10px}.aa-evidence-top{display:flex;justify-content:space-between;color:#4e9280;font-size:9px;font-weight:800}.aa-evidence-title{font-size:11px;font-weight:800;margin:10px 0}.aa-evidence p,.aa-small{font-size:10px;color:#81929e;line-height:1.65}.aa-evidence a{display:flex;align-items:center;gap:5px;color:#467b8e;font-size:10px;font-weight:700}.aa-error{background:#fff2f1;border:1px solid #f2c0bd;color:#b04737;border-radius:9px;padding:10px 14px;font-size:12px}.aa-spin{animation:aa-spin .8s linear infinite}@keyframes aa-spin{to{transform:rotate(360deg)}}
/* Model Lab */
.aa-lab-page{min-height:100vh}.aa-lab-top{background:#102230;color:#fff;padding:20px max(25px,calc((100vw - 1190px)/2));display:flex;align-items:center;justify-content:space-between}.aa-lab-brand{display:flex;align-items:center;gap:9px;font:800 18px Manrope}.aa-back{display:flex;gap:8px;align-items:center;font-size:12px;color:#c7d6db}.aa-lab-body{max-width:1190px;margin:auto;padding:40px 25px 70px}.aa-lab-hero{max-width:670px;margin-bottom:32px}.aa-lab-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px}.aa-lab-stats>div{background:#fff;border:1px solid var(--border);padding:20px;border-radius:14px;display:flex;flex-direction:column;gap:10px}.aa-lab-stats svg{color:#83a394}.aa-lab-stats span{font-size:11px;color:#8596a0}.aa-lab-stats strong{font:800 28px Manrope;letter-spacing:-1px}.aa-lab-stats small{font-size:10px;color:#a2adb5}.aa-lab-panel{border:1px solid var(--border);border-radius:15px;padding:25px;background:#fff;margin-bottom:22px}.aa-lab-section-title{display:flex;gap:13px;align-items:center;margin-bottom:22px}.aa-lab-section-title>svg{color:#698a82}.aa-lab-section-title h2{font:800 17px Manrope;margin:0}.aa-lab-section-title p{color:#9da8b1;font-size:11px;margin:5px 0}.aa-model-grid,.aa-lab-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.aa-lab-model{border:1px solid #e6ebed;border-radius:12px;padding:18px}.aa-lab-model-head h3{margin:0 0 6px;font:800 13px Manrope}.aa-lab-model-head span{font-size:10px;color:#8ca0ad}.aa-model-metric{margin:19px 0}.aa-model-metric>div:first-child{display:flex;justify-content:space-between;font-size:11px;color:#6d808d}.aa-model-metric b{color:#203a49}.aa-lab-note{font-size:11px;line-height:1.8;color:#81949e;background:#f8faf9;border-radius:9px;padding:12px;margin:18px 0 0}.aa-architecture{padding-left:22px;font-size:12px;line-height:2.4;color:#5c7280}.aa-lab-experiments{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.aa-lab-experiments>div{border:1px solid #e6ecee;border-radius:12px;padding:18px}.aa-lab-experiments span{font:800 22px Manrope;color:#315e62}.aa-lab-experiments p{font-size:11px;color:#81929e;line-height:1.6}
@media(max-width:1150px){.aa-nav{width:210px}.aa-main-inner{grid-template-columns:minmax(0,1fr) 270px}.aa-chat-area{padding:0 24px 20px}.aa-side-rail{padding:18px}}
@media(max-width:900px){.aa-main-inner{grid-template-columns:1fr}.aa-side-rail{border-left:0;border-top:1px solid var(--border);display:grid;grid-template-columns:1fr 1fr;gap:12px}.aa-side-rail>*{margin-bottom:0}.aa-workflow{grid-row:span 2}.aa-lab-stats{grid-template-columns:repeat(2,1fr)}}
@media(max-width:660px){.aa-app{display:block}.aa-nav{width:100%;padding:15px 20px;flex-direction:row;justify-content:space-between;align-items:center}.aa-nav-items{margin:0;flex-direction:row}.aa-nav-items a{padding:9px;font-size:11px}.aa-nav-footer{display:none}.aa-brand{font-size:15px}.aa-brand-sub{display:none}.aa-topbar{padding:0 15px;height:55px}.aa-topbar-right{display:none}.aa-chat-area{padding:0 17px 20px}.aa-welcome{padding:35px 0 15px}.aa-welcome h1{font-size:29px}.aa-suggestions{margin-top:23px}.aa-side-rail{grid-template-columns:1fr;padding:14px}.aa-workflow{grid-row:auto}.aa-message-content{max-width:90%}.aa-results{margin-left:0}.aa-lab-two,.aa-lab-experiments{grid-template-columns:1fr}.aa-lab-stats{grid-template-columns:repeat(2,1fr)}.aa-lab-top{padding:18px}.aa-back{font-size:10px}}
