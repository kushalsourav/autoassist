# AutoAssist — root .gitignore
# Keep source code, lockfiles, schema, tests, eval fixtures, and the main README in Git.

# Local secrets and machine-specific configuration
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# Python / virtual environments / test caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
coverage.xml
htmlcov/
*.egg-info/
build/
dist/

# Node / Next.js
**/node_modules/
**/.next/
**/.turbo/
**/out/
**/.vercel/
**/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local DBs, runtime state, chat data
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-*
*.log
logs/
.tmp/
tmp/

# Downloaded datasets, trained weights, generated embeddings and reports
ml/artifacts/
ml/data/raw/
ml/data/processed/
ml/data/cache/
ml/checkpoints/
**/checkpoints/
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.faiss
*.index
*.npy
*.npz
*.parquet

# Local generated evaluation results (retain source code and labeled fixtures)
ml/artifacts/rag_eval_v1/
ml/artifacts/multivehicle_eval_v2/

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# One-off patch instructions; KEEP the main README.md for GitHub
README-*.md

# Temporary patch documentation
/README-*.md
/READ_ME_FIRST.md
/.ui-v4-backup/
/.release-v5-backup/
/.release-v6-backup/
/.v7-backup/
/.create-agent-v8-backup/
/.v10-backup/
