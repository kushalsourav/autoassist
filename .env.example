# Backend: copy to repo root as .env
STORAGE_MODE=local
MODEL_VARIANT=baseline
DATABASE_PATH=backend/autoassist.db
# Required for STORAGE_MODE=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional (unconfigured app returns evidence-only, clearly marked)
OPENROUTER_API_KEY=
# Set to an actual model ID currently available on your account
OPENROUTER_MODEL=
CORS_ORIGINS=http://localhost:3000

# Larger reasoning models can take longer than the previous 30s timeout.
OPENROUTER_TIMEOUT_SECONDS=90
